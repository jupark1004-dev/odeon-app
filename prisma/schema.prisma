generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. 사용자 (뮤지션 & 관객/팬)
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  emailVerified  DateTime?
  password       String?   // bcrypt 해시 저장 (소셜 로그인 시 null 가능)
  username       String?   // 활동명 / 팀명 / 닉네임
  role           String    @default("FAN")  // 'ARTIST' 또는 'FAN'
  genre          String?   // 예: 'AI 버추얼 싱어', '인디 밴드', '지하아이돌', '싱어송라이터'
  bio            String?   // 아티스트 소개 및 팀 서사
  image          String?   // 프로필 이미지 (업로드 Data URL 또는 외부 URL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // NextAuth 어댑터 필수 관계
  accounts       Account[]
  sessions       Session[]

  // B1F 서비스 데이터 관계
  liveStreams    LiveStream[]
  posts          Post[]
  tickets        Ticket[]
  sentCheers     Cheer[]   @relation("SentCheers")
  receivedCheers Cheer[]   @relation("ReceivedCheers")
}

// NextAuth 필수 — 소셜 계정 연결 정보
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth 필수 — 세션
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth 필수 — 이메일 인증 토큰
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 2. B1F 라이브하우스 무대 (공연 예고 / 실시간 무대 / 음원 리스닝 스테이지)
model LiveStream {
  id           String    @id @default(uuid())
  artistId     String
  artist       User      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title        String
  embedUrl     String    @default("") // 유튜브 URL (없을 경우 음원+비주얼 스테이지로 동작)
  coverImage   String?   // 무대 비주얼 / 아티스트 이미지
  audioUrl     String?   // 직접 업로드한 무대 음원 또는 오디오 URL
  isLive       Boolean   @default(false)
  status       String    @default("UPCOMING") // 'UPCOMING' | 'LIVE' | 'ENDED'
  scheduledAt  DateTime  @default(now())      // 공연 일시 (타임테이블 & D-Day용)
  setlist      String?   // 셋리스트 (줄바꿈 구분)
  description  String?   // 공연 소개 및 무대 각오
  createdAt    DateTime  @default(now())

  tickets      Ticket[]
  cheers       Cheer[]
  practiceLogs Post[]
}

// 3. 지하 연습실 / 작업실 일지 (Practice Log — 습작 음원 + 연습/컨셉 사진 + 영상 기록)
model Post {
  id          String      @id @default(uuid())
  artistId    String
  artist      User        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  content     String      // 오늘의 연습 일지 / 작업 노트
  mediaUrl    String?     // 연습/컨셉 사진(업로드) 또는 유튜브 영상 URL
  audioUrl    String?     // 습작/데모 음원 파일(업로드) 또는 오디오 URL
  audioTitle  String?     // 습작 음원 트랙명 (예: "Demo #3 - 새벽의 목소리 (Rough Mix)")
  practiceDay Int         @default(1)          // 연습/작업 N일차 (예: Day 14)
  category    String      @default("합주/연습") // '곡 작업/습작음원' | '컨셉/연습사진' | '합주/연습' | '보컬/안무' | '백스테이지'
  stageId     String?     // 어떤 무대를 준비하는 과정인지 연결
  stage       LiveStream? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
}

// 4. B1F 무대 입장권 (정리번호 티켓 발권 / RSVP)
model Ticket {
  id          String     @id @default(uuid())
  streamId    String
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryNumber Int        // 입장 정리번호 (#001, #002...)
  createdAt   DateTime   @default(now())

  @@unique([streamId, userId])
}

// 5. 무대 응원 슬로건 (초코 후원을 대체하는 순수 관객 응원)
model Cheer {
  id         String      @id @default(uuid())
  senderId   String
  sender     User        @relation("SentCheers", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User        @relation("ReceivedCheers", fields: [receiverId], references: [id], onDelete: Cascade)
  streamId   String?
  stream     LiveStream? @relation(fields: [streamId], references: [id], onDelete: Cascade)
  badge      String      @default("🔥 최애무대") // 슬로건 태그
  message    String
  createdAt  DateTime    @default(now())
}
